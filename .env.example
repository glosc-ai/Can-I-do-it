# Application
APP_ENV=development
LOG_LEVEL=info
API_PORT=8080
WEB_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL (Docker Compose default)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DB_DRIVER=postgres
DATABASE_URL=postgres://app:app@postgres:5432/app?sslmode=disable
AUTO_MIGRATE=true
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# MySQL alternative:
# DB_DRIVER=mysql
# DATABASE_URL=app:app@tcp(mysql:3306)/app?parseTime=true&charset=utf8mb4

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication - use: openssl rand -base64 32
JWT_SECRET=replace-this-development-secret-before-production
JWT_ISSUER=go-vue-starter
JWT_TTL=24h

# Gloscai SSO (OAuth 2.0 / OpenID Connect)
# Register the exact callback URL in the SSO client dashboard.
SSO_DISCOVERY_URL=https://sso.gloscai.com/api/.well-known/openid-configuration
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Development: http://localhost:5173/api/v1/auth/callback
# Docker production: http://localhost:3000/api/v1/auth/callback
SSO_REDIRECT_URI=http://localhost:5173/api/v1/auth/callback

# Application session and protected settings
SESSION_COOKIE_NAME=can_i_session
SESSION_TTL=24h
# Required when saving an AI API key from the owner console; use a random 32-byte value.
APP_ENCRYPTION_KEY=

# Uploads and OpenAI-compatible analysis provider
UPLOAD_DIR=/data/uploads
AI_ENDPOINT=
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://api:8080
