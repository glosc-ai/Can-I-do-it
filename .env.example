# Application
APP_ENV=development
LOG_LEVEL=info
API_PORT=8080
# 生产 compose 使用的镜像标签（ghcr.io/glosc-ai/can-i-do-it）。
# 留空/默认跟随 latest，可固定为具体版本，如 1.0.0。
APP_IMAGE_TAG=latest
# Docker production serves the API and the built frontend from one process
# on API_PORT, so the browser is same-origin and CORS_ORIGINS can stay empty.
# Only set it if you need cross-origin access (e.g. a separate dev frontend).
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (Docker Compose default)
# 这些变量既用于初始化 postgres 容器，也用于服务端自动拼接连接串，
# 改密码只需要改这一处，不会再出现 DATABASE_URL 里残留旧密码导致的
# "password authentication failed (SQLSTATE 28P01)"。
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_SSLMODE=disable
DB_DRIVER=postgres
# 留空即自动拼接（compose 内主机名为 postgres，本机开发为 localhost）。
# 仅当需要连接外部数据库、或要用连接池等特殊参数时才显式填写；
# 一旦填写就以它为准，上面的 POSTGRES_* 将不再参与拼接。
DATABASE_URL=
AUTO_MIGRATE=true
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# MySQL alternative（同样支持自动拼接，留空 DATABASE_URL 即可）:
# DB_DRIVER=mysql
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_DATABASE=app
# MYSQL_USER=app
# MYSQL_PASSWORD=app

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication - use: openssl rand -base64 32
JWT_SECRET=replace-this-development-secret-before-production
JWT_ISSUER=go-vue-starter
JWT_TTL=24h

# Gloscai SSO (OAuth 2.0 / OpenID Connect)
# Register the exact callback URL in the SSO client dashboard.
SSO_DISCOVERY_URL=https://sso.gloscai.com/api/.well-known/openid-configuration
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Development: http://localhost:5173/api/v1/auth/callback
# Docker production: http://localhost:8080/api/v1/auth/callback
SSO_REDIRECT_URI=http://localhost:5173/api/v1/auth/callback

# Application session and protected settings
SESSION_COOKIE_NAME=can_i_session
SESSION_TTL=24h
# Required when saving an AI API key from the owner console; use a random 32-byte value.
APP_ENCRYPTION_KEY=

# Uploads and OpenAI-compatible analysis provider
UPLOAD_DIR=/data/uploads
# Optional Cloudflare R2 (S3-compatible) defaults. The owner console can
# configure/override these values and encrypt credentials in app_settings.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
R2_REGION=auto
R2_FORCE_PATH_STYLE=false
AI_ENDPOINT=
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://api:8080
